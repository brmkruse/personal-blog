---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { usfBullsSrc } from '../assets/usf-bulls';

const companyLogos = {
  rapid7: '/logos/rapid7.svg',
  bigcommerce: '/logos/bigcommerce.svg',
  box: '/logos/box.svg',
  uship: '/logos/uship.svg',
};

const competencies = [
  {
    title: 'Technical Selling',
    items: [
      'Full-Cycle Ownership',
      'Multi-Threading',
      'Security, Engineering & C-suite Engagement',
      'Problem & Workflow Mapping',
      'POC/POV Project Management',
      'Business Case Development',
      'Legal & Procurement Negotiation',
      'Deployment & Integration',
    ],
  },
  {
    title: 'Security, Cloud & AI',
    items: [
      'Security Platforms (MDR, CNAPP, SIEM, VRM, CTEM, SOAR)',
      'Network & Application Security',
      'Identity Security (IAM/PAM/ZTA/NHI)',
      'Cloud Infrastructure',
      'GenAI',
      'Cloud Agents (Claude Code, OpenClaw, Grok Bot)',
      'LLM Models, Harnesses & Gateways',
      'MCP Servers',
    ],
  },
  {
    title: 'GTM Execution',
    items: [
      'Pipeline & Playbook Development',
      'Land & Expansion',
      'Territory & Account Planning',
      'MEDDPICC',
      'Cross-Functional Close (SE, Services, Product, Engineering, Legal)',
      'Channel / VAR Co-Sell',
      'Product & Marketing Feedback Loops',
      'PLG & Sales-led motions',
      'GTM tech: SFDC, Gong, Clari, Claude',
    ],
  },
];

// Phrases kept on one line in Experience bullets.
const nowrapTerms = [
  'six-figure',
  'run-rate',
  '$20MM',
  'sales-sourced',
  'post-sales',
  'FY19 112%',
  'FY20 127%',
  'FY21 141%',
  'FY22 87%',
  '$1.2MM',
];
const escapeRegExp = (t: string) => t.replace(/[.*+?^$()|[\]\\{}]/g, '\\$&');
const nowrapPattern = new RegExp('(' + nowrapTerms.map(escapeRegExp).join('|') + ')');
const splitNowrap = (text: string) =>
  text.split(nowrapPattern).map((part) => ({ part, nowrap: nowrapTerms.includes(part) }));

const roles = [
  {
    title: 'Manager, Commercial Sales — Central',
    company: 'Rapid7',
    descriptor: 'Cybersecurity platform (MDR, SIEM, CNAPP, CTEM)',
    logo: 'rapid7',
    logoClass: 'wordmark',
    location: 'Austin, TX',
    dates: '2023 – Aug. 2026',
    bullets: [
      'Owned a $20MM run-rate book with customers across FinServ, Healthcare, Tech, and Manufacturing, while also running multiple six-figure deal cycles directly with CIOs, CISOs, CTOs, security, cloud and infrastructure engineers.',
      'Led the team to exceed quota and achieve President\'s Club recognition for outstanding performance.',
    ],
  },
  {
    title: 'Senior Account Executive, Mid-Market — TOLA/Southeast',
    company: 'BigCommerce (now Commerce)',
    descriptor: 'Headless, API-first commerce platform',
    logo: 'bigcommerce',
    logoClass: 'mark',
    location: 'Austin, TX',
    dates: '2018 – 2023',
    bullets: [
      '116% average attainment over four years: FY19 112%, FY20 127%, FY21 141%, FY22 87% on a $1.2MM quota.',
      'Sold to CTOs, frontend and backend engineers, and SRE teams responsible for integrations, APIs, customizations, and site performance at mid-market and F1000 accounts.',
      'Partnered with Solutions Engineers to run technical discovery, demos, POCs, and post-sales deployment calls.',
    ],
  },
  {
    title: 'Senior Manager, Enterprise Sales Development',
    company: null,
    descriptor: null,
    logo: null,
    logoClass: null,
    location: null,
    dates: null,
    bullets: [
      'Led the Enterprise SDR team to exceed quota; scaled headcount from 2 to 16 ICs + 2 managers, and promoted 6 team members in 18 months.',
      'Restructured the team into Inbound, Outbound, and Account Development functions to optimize workflows and create a new talent pool.',
    ],
  },
  {
    title: 'Manager, Outbound Business — Enterprise, Large Enterprise & Strategic',
    company: 'Box, Inc.',
    descriptor: 'Cloud Content Management & Intelligence platform',
    logo: 'box',
    logoClass: 'wordmark',
    location: 'Austin, TX',
    dates: '2016 – 2018',
    bullets: [
      'Developed outbound playbook that led to 127% annual quota attainment supporting Enterprise, Large Enterprise, and Strategic accounts.',
      'Engaged CIOs, CDOs, Enterprise Architects, Platform & Infrastructure Engineers to generate outbound, sales-sourced pipeline.',
    ],
  },
  {
    title: 'Commercial Account Executive & Sales Manager',
    company: 'uShip, Inc.',
    descriptor: 'Series B logistics platform',
    logo: 'uship',
    logoClass: 'wordmark',
    location: 'Austin, TX',
    dates: '2012 – 2016',
    bullets: [
      'One of the first sales hires (employee #92); top-performing AE promoted to company’s first Sales Manager role.',
      'Built the first B2B sales motion from $0 to $1MM with Engineering, Product, Marketing, and the executive team.',
    ],
  },
];
---

<BaseLayout
  title="Professional XP"
  description="Brandon Kruse — Account Executive & Sales Leader | Cybersecurity, Cloud & AI GTM. Experience, competencies, and education."
>
  <Header />
  <main class="page">
    <header class="hero">
      <p class="eyebrow">Professional XP</p>
      <h1>Brandon Kruse</h1>
      <p class="headline">Account Executive &amp; Sales Leader | Cybersecurity, Cloud &amp; AI GTM</p>
    </header>

    <section class="section" aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary</h2>
      <p class="summary">
        Full-cycle technical seller with 10+ years of experience closing security, cloud, and <span
          class="nowrap">API-first</span> platform deals and exceeding quota at both PLG and sales-led
        companies. Skilled at
        multi-threading practitioners and executive buyers across engineering and security
        organizations, and becoming a trusted thought partner with customers. Most recently led
        Rapid7’s Commercial GTM team while running deals with CIOs, CISOs, CTOs, and engineering
        teams. Built AI into the team’s sales motion (account research, meeting prep, an SE bot, and
        pipeline reviews). Mechanical Engineering grad and daily user of frontier models and cloud
        agents. Experienced building and executing playbooks at early-stage startups and public
        companies. Ready to bring a high-agency motion and curious mindset back to an Enterprise AE
        role to help build at a high-growth security/AI infrastructure company.
      </p>
    </section>

    <section class="section" aria-labelledby="competencies-heading">
      <h2 id="competencies-heading">Skills and Competencies</h2>
      <div class="comp-grid">
        {
          competencies.map((group) => (
            <div class="comp-card">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    {item.split('C-suite').map((part, i) => (
                      <>
                        {i > 0 && <span class="nowrap">C-suite</span>}
                        {part}
                      </>
                    ))}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="roles">
        {
          roles.map((role) => (
            <article class="role-row">
              <div class="role-copy">
                <div class="role-head">
                  <h3 class="role-title">
                    {role.title} {role.company && <span class="co">· {role.company}</span>}
                  </h3>
                  {role.location && (
                    <p class="loc">{role.location}{role.descriptor ? ` | ${role.descriptor}` : ''}</p>
                  )}
                </div>
                <ul>
                  {role.bullets.map((b) => (
                    <li>
                      {splitNowrap(b).map(({ part, nowrap }) =>
                        nowrap ? <span class="nowrap">{part}</span> : part,
                      )}
                    </li>
                  ))}
                </ul>
              </div>
              {(role.dates || role.logo) && (
                <div class="role-aside">
                  {role.dates && <p class="dates">{role.dates}</p>}
                  {role.logo && (
                    <div
                      class:list={['role-logo', role.logoClass]}
                      aria-hidden="true"
                    >
                      <img src={companyLogos[role.logo as keyof typeof companyLogos]} alt="" />
                    </div>
                  )}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="section education" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="edu-row">
        <div class="edu-copy">
          <p class="edu-degree">B.S. Mechanical Engineering - University of South Florida</p>
          <p class="loc">Tampa, FL</p>
          <ul>
            <li>Self-funded education through part-time work and scholarships.</li>
          </ul>
        </div>
        <div class="edu-logo" aria-hidden="true">
          <img src={usfBullsSrc} alt="" width="98" height="78" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    max-width: 740px;
    margin: 0 auto;
    padding: 3rem 1.25rem 1rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .hero h1 {
    margin: 0 0 0.45rem;
    font-size: clamp(2rem, 5vw, 2.6rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .headline {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .section {
    margin-top: 2.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .section h2 {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .comp-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .comp-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .comp-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.1rem 1.15rem;
    background: transparent;
  }

  .comp-card h3 {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .comp-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .comp-card li {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
    padding: 0.28rem 0;
    border-top: 1px solid var(--border);
  }

  .comp-card li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .nowrap {
    white-space: nowrap;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 1.85rem;
  }

  .role-head {
    margin-bottom: 0.65rem;
  }

  .role-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .role-title .co {
    font-weight: 500;
    color: var(--muted);
  }

  .role-aside {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 0.85rem;
    width: 118px;
  }

  .dates {
    margin: 0;
    color: var(--muted);
    font-size: 0.925rem;
    white-space: nowrap;
    text-align: right;
    line-height: 1.3;
  }

  .loc {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.925rem;
  }

  .role ul,
  .education ul {
    margin: 0.65rem 0 0;
    padding-left: 1.15rem;
  }

  .role li,
  .education li {
    color: var(--muted);
    font-size: 0.975rem;
    line-height: 1.55;
    margin-bottom: 0.4rem;
  }

  .role li:last-child,
  .education li:last-child {
    margin-bottom: 0;
  }

  .edu-degree {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .role-row {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
  }

  .role-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .role-logo {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    min-height: 48px;
  }

  .role-logo img {
    display: block;
    width: auto;
    height: auto;
    max-height: 48px;
    max-width: 118px;
    object-fit: contain;
  }

  .role-logo.wordmark img {
    max-height: 36px;
    max-width: 118px;
  }

  .role-logo.mark img {
    max-height: 48px;
    max-width: 48px;
  }

  .edu-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .edu-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .edu-logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 0.1rem;
  }

  .edu-logo img {
    display: block;
    width: auto;
    height: 78px;
    max-width: 98px;
    object-fit: contain;
  }
</style>
