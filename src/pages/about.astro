---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About" description="About Kruse — coding beginner learning in public.">
  <Header />
  <main class="page">
    <header class="page-header">
      <h1>About</h1>
    </header>

    <div class="prose">
      <p>
        I'm Kruse, a coding beginner building a habit of learning out loud. This site is where
        I collect the lessons that stick — how to start projects, how to read error messages,
        and how to keep going when something feels too hard.
      </p>
      <p>
        I care about clear writing, small experiments, and tools that stay out of the way.
        Most posts start as notes to my future self. If they help someone else too, even better.
      </p>
      <p>
        Right now I'm focused on web basics: HTML, CSS, JavaScript, Git, and Astro. Expect
        practical write-ups more than polished tutorials.
      </p>
      <p>
        Thanks for reading. If you want to say hi, find me on GitHub as
        <a href="https://github.com/brmkruse">brmkruse</a>.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 3rem 1.25rem 1rem;
  }

  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    letter-spacing: -0.03em;
  }

  .prose p {
    margin: 0 0 1.15rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
