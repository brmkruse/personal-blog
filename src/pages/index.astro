---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pills = [
  { label: 'Full-Cycle Ownership', top: '8%', left: '6%', delay: '0s' },
  { label: 'Complex Multi-Threaded Deals', top: '14%', left: '58%', delay: '0.4s' },
  { label: 'CIO / CISO / CTO Engagement', top: '22%', left: '28%', delay: '0.8s' },
  { label: 'Technical Discovery & Workflow Mapping', top: '6%', left: '34%', delay: '1.1s' },
  { label: 'POC / POV Project Management', top: '32%', left: '8%', delay: '0.2s' },
  { label: 'Value & Outcome-Driven ROI', top: '28%', left: '68%', delay: '1.4s' },
  { label: 'CNAPP/CSPM', top: '42%', left: '42%', delay: '0.6s' },
  { label: 'SIEM/MDR/CTEM', top: '48%', left: '14%', delay: '1.7s' },
  { label: 'Threat Intelligence', top: '18%', left: '78%', delay: '0.9s' },
  { label: 'AI/LLM Governance', top: '58%', left: '62%', delay: '1.2s' },
  { label: 'Frontier LLMs & Agentic Workflows', top: '62%', left: '22%', delay: '0.3s' },
  { label: 'NIST/ISO/CIS Framework Mapping', top: '72%', left: '48%', delay: '1.5s' },
  { label: 'New Logo & Expansion', top: '78%', left: '10%', delay: '0.7s' },
  { label: 'Channel / VAR Co-Sell', top: '70%', left: '74%', delay: '1.0s' },
  { label: 'MEDDPICC', top: '84%', left: '36%', delay: '1.8s' },
];

const typewriterLines = [
  "Hey, I'm Brandon",
  'Technical sales. Cybersecurity & AI.',
  'Looking for a high-impact AE / Account Director seat.',
  'Scroll down, or click a skill to explore.',
];
---

<BaseLayout
  title="XKruse"
  description="Technical sales, cybersecurity, and AI. Looking for a high-impact individual contributor role."
>
  <Header />
  <main>
    <section class="hero" aria-label="Expertise">
      <div class="pill-field" aria-hidden="true">
        {
          pills.map((pill) => (
            <a
              class="pill"
              href="/professional"
              style={`top:${pill.top};left:${pill.left};animation-delay:${pill.delay}`}
            >
              {pill.label}
            </a>
          ))
        }
      </div>
      <div class="hero-copy">
        <p class="typewriter" data-lines={JSON.stringify(typewriterLines)}>
          <span class="typewriter-text"></span><span class="caret" aria-hidden="true">|</span>
        </p>
      </div>
    </section>

    <section class="intro-wrap" aria-label="Introduction">
      <div class="intro-card">
        <h1>Hello!</h1>
        <p>
          Previously Rapid7 and Box. Looking to return to a high-impact individual contributor
          AE / Account Director seat at an AI-native or cyber company. Cybersecurity, AI, and
          longevity health nerd based in Austin, TX.
        </p>
        <div class="intro-actions">
          <a class="btn" href="/professional">Professional</a>
          <a class="text-link" href="/writing">Interests</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const root = document.querySelector('.typewriter');
  const textEl = document.querySelector('.typewriter-text');
  if (root instanceof HTMLElement && textEl instanceof HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const raw = root.dataset.lines ?? '[]';
    let lines: string[] = [];
    try {
      lines = JSON.parse(raw);
    } catch {
      lines = ["Hey, I'm Brandon"];
    }

    if (reduce || lines.length === 0) {
      textEl.textContent = lines[0] ?? '';
      const caret = root.querySelector('.caret');
      if (caret) caret.remove();
    } else {
      let lineIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const line = lines[lineIndex] ?? '';
        if (!deleting) {
          charIndex += 1;
          textEl.textContent = line.slice(0, charIndex);
          if (charIndex >= line.length) {
            deleting = true;
            window.setTimeout(tick, 1800);
            return;
          }
          window.setTimeout(tick, 42);
        } else {
          charIndex -= 1;
          textEl.textContent = line.slice(0, Math.max(0, charIndex));
          if (charIndex <= 0) {
            deleting = false;
            lineIndex = (lineIndex + 1) % lines.length;
            window.setTimeout(tick, 320);
            return;
          }
          window.setTimeout(tick, 24);
        }
      };

      tick();
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(72vh, 640px);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(56, 132, 255, 0.18), transparent 55%),
      linear-gradient(180deg, #0c1422 0%, #0a0a0a 100%);
    border-bottom: 1px solid var(--border);
  }

  .pill-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pill {
    position: absolute;
    pointer-events: auto;
    max-width: min(42vw, 260px);
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(110, 168, 255, 0.55);
    border-radius: 999px;
    background: rgba(12, 20, 34, 0.72);
    color: #9ec1ff;
    font-size: clamp(0.58rem, 1.4vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: drift 9s ease-in-out infinite alternate;
    backdrop-filter: blur(4px);
  }

  .pill:hover {
    color: #e8f1ff;
    border-color: #8bb6ff;
    background: rgba(30, 52, 88, 0.9);
    text-decoration: none;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    min-height: inherit;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .typewriter {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.65rem, 5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.2;
    background: linear-gradient(90deg, #6eb0ff 0%, #f2f2f2 55%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .typewriter-text {
    white-space: pre-wrap;
  }

  .caret {
    display: inline-block;
    margin-left: 0.05em;
    color: #6eb0ff;
    -webkit-text-fill-color: #6eb0ff;
    animation: blink 1s steps(1) infinite;
  }

  .intro-wrap {
    padding: 3.5rem 1.25rem 1rem;
    background:
      radial-gradient(circle at 20% 20%, rgba(56, 132, 255, 0.06), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(56, 132, 255, 0.05), transparent 35%);
  }

  .intro-card {
    max-width: 560px;
    margin: 0 auto;
    padding: 2rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: linear-gradient(180deg, #121216 0%, #0e0e11 100%);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    border-left: 3px solid #3d8b6e;
    border-right: 3px solid #3b82f6;
  }

  .intro-card h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    letter-spacing: -0.03em;
  }

  .intro-card p {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(110, 168, 255, 0.7);
    border-radius: 999px;
    color: #cfe0ff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .btn:hover {
    background: rgba(59, 130, 246, 0.15);
    text-decoration: none;
  }

  .text-link {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -10px, 0);
    }
  }

  @keyframes blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill {
      animation: none;
    }

    .caret {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 560px;
    }

    .pill {
      max-width: 46vw;
      font-size: 0.55rem;
      padding: 0.28rem 0.55rem;
    }

    .typewriter {
      max-width: 14ch;
    }
  }
</style>
