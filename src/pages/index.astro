  { label: 'Full-Cycle Ownership', top: 5, left: 28 },
  { label: 'Consultative selling', top: 4, left: 52 },
  { label: 'Complex Multi-Threaded Deals', top: 6, left: 72 },
  { label: 'Hiring', top: 8, left: 90 },
  // upper band
  { label: 'Threat Intelligence', top: 14, left: 2 },
  { label: 'CIO / CISO / CTO Engagement', top: 15, left: 18 },
  { label: 'Workflow Mapping', top: 13, left: 78 },
  { label: 'Negotiation', top: 16, left: 92 },
  // upper-mid sides
  { label: 'POC / POV Project Management', top: 24, left: 3 },
  { label: 'Solution selling', top: 22, left: 88 },
  { label: 'CNAPP', top: 30, left: 5 },
  { label: 'Outcome-Driven ROI', top: 28, left: 78 },
  { label: 'CSPM', top: 29, left: 92 },
  { label: 'Commerce', top: 34, left: 16 },
  { label: 'Gong', top: 33, left: 70 },
  // mid sides
  { label: 'CIEM', top: 40, left: 4 },
  { label: 'SIEM', top: 38, left: 90 },
  { label: 'Platform', top: 44, left: 8 },
  { label: 'API', top: 42, left: 82 },
  { label: 'MDR', top: 48, left: 3 },
  { label: 'CTEM', top: 46, left: 74 },
  { label: 'Leadership', top: 50, left: 88 },
  { label: 'Infrastructure', top: 52, left: 10 },
  { label: 'Deployment', top: 54, left: 78 },
  // lower-mid
  { label: 'AI/LLM Governance', top: 58, left: 5 },
  { label: 'Agentic Workflows', top: 56, left: 68 },
  { label: 'Frontier LLMs', top: 62, left: 16 },
  { label: 'SFDC', top: 60, left: 88 },
  { label: 'Agent harness', top: 64, left: 6 },
  { label: 'Integrations', top: 63, left: 74 },
  // lower band
  { label: 'NIST/ISO/CIS Framework Mapping', top: 68, left: 28 },
  { label: 'Enterprise Content Management', top: 70, left: 54 },
  { label: 'New logo land', top: 72, left: 4 },
  { label: 'Customer expansion', top: 71, left: 80 },
  { label: 'Channel / VAR Co-Sell', top: 76, left: 18 },
  { label: 'Pipeline Generation', top: 75, left: 48 },
  { label: 'MEDDPICC', top: 78, left: 66 },
  // bottom band
  { label: 'Forecasting', top: 84, left: 6 },
  { label: 'SDLC', top: 83, left: 28 },
  { label: 'Developer workflows', top: 82, left: 48 },
  { label: 'Knowledge worker workflows', top: 86, left: 68 },
  { label: 'Daily AI practitioner', top: 90, left: 22 },
];
---

<BaseLayout
  title="XKruse"
  description="Technical sales, cybersecurity, and AI. Looking for a high-impact individual contributor role."
>
  <Header />
  <main>
    <section class="hero" aria-label="Expertise">
      <div class="pill-field" id="pill-field">
        {
          pills.map((pill, index) => (
            <a
              class="pill"
              href="/professional"
              data-top={String(pill.top)}
              data-left={String(pill.left)}
              data-index={String(index)}
            >
              {pill.label}
            </a>
          ))
        }
      </div>
      <div class="hero-copy">
        <p class="typewriter">
          <span class="typewriter-text" id="typewriter-text"></span><span class="caret" aria-hidden="true">|</span>
        </p>
      </div>
    </section>

    <section class="intro-wrap" aria-label="Introduction">
      <div class="intro-card">
        <h1>Hello from Austin, TX!</h1>
        <p>
          Experienced seller in both Account Executive (AE) and sales leadership roles. Former
          Rapid7, Commerce, and Box. Looking to return to a high-impact individual contributor
          AE / Account Director seat at an AI-native or cyber company.
        </p>
        <p>
          I built this website as my first project using cloud agents. Thank you for checking it
          out!
        </p>
        <div class="intro-actions">
          <a class="btn" href="/professional">Professional</a>
          <a class="text-link" href="/writing">Interests</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (function () {
    // Typewriter
    var textEl = document.getElementById('typewriter-text');
    if (textEl) {
      var lines = [
        "Hi, I'm Brandon.",
        'Most people call me Kruse.',
        'I have deep experience selling complex, highly technical solutions.',
        'Checkout some of my skills and competencies.',
      ];
      var lineIndex = 0;
      var charIndex = 0;
      var deleting = false;

      function typeTick() {
        var line = lines[lineIndex] || '';
        if (!deleting) {
          charIndex += 1;
          textEl.textContent = line.slice(0, charIndex);
          if (charIndex >= line.length) {
            deleting = true;
            window.setTimeout(typeTick, 2600);
            return;
          }
          window.setTimeout(typeTick, 68);
        } else {
          charIndex -= 1;
          textEl.textContent = line.slice(0, Math.max(0, charIndex));
          if (charIndex <= 0) {
            deleting = false;
            lineIndex = (lineIndex + 1) % lines.length;
            window.setTimeout(typeTick, 500);
            return;
          }
          window.setTimeout(typeTick, 36);
        }
      }
      typeTick();
    }

    // Floating pills: scatter → settle → gentle drift
    var field = document.getElementById('pill-field');
    if (!field) return;
    var nodes = Array.prototype.slice.call(field.querySelectorAll('.pill'));
    if (!nodes.length) return;

    function rand(min, max) {
      return min + Math.random() * (max - min);
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    var items = nodes.map(function (el, i) {
      var targetTop = parseFloat(el.getAttribute('data-top') || '50');
      var targetLeft = parseFloat(el.getAttribute('data-left') || '50');
      // Start scattered around the field (bias away from exact center)
      var startTop = rand(2, 92);
      var startLeft = rand(1, 90);
      if (Math.abs(startTop - 45) < 12 && Math.abs(startLeft - 45) < 20) {
        startTop = startTop < 45 ? rand(2, 28) : rand(62, 92);
      }
      el.style.top = startTop + '%';
      el.style.left = startLeft + '%';
      el.style.opacity = '0';
      el.classList.add('is-animating');

      return {
        el: el,
        startTop: startTop,
        startLeft: startLeft,
        targetTop: targetTop,
        targetLeft: targetLeft,
        // stagger settle
        settleDelay: i * 28 + rand(0, 120),
        settleMs: rand(1100, 1700),
        // continuous float params
        ampX: rand(6, 18),
        ampY: rand(8, 22),
        speedX: rand(0.00035, 0.0007),
        speedY: rand(0.0004, 0.00085),
        phaseX: rand(0, Math.PI * 2),
        phaseY: rand(0, Math.PI * 2),
        settled: false,
      };
    });

    var start = performance.now();

    function frame(now) {
      var elapsed = now - start;

      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var el = item.el;
        var local = elapsed - item.settleDelay;

        if (local < 0) {
          el.style.opacity = '0';
          continue;
        }

        if (!item.settled) {
          var t = Math.min(1, local / item.settleMs);
          var e = easeOutCubic(t);
          var top = item.startTop + (item.targetTop - item.startTop) * e;
          var left = item.startLeft + (item.targetLeft - item.startLeft) * e;
          el.style.top = top + '%';
          el.style.left = left + '%';
          el.style.opacity = String(Math.min(1, t * 1.35));
          el.style.transform = 'translate3d(0,0,0) scale(' + (0.86 + 0.14 * e) + ')';

          if (t >= 1) {
            item.settled = true;
            el.style.top = item.targetTop + '%';
            el.style.left = item.targetLeft + '%';
            el.style.opacity = '1';
            el.classList.remove('is-animating');
          }
        } else {
          var ox = Math.sin(now * item.speedX + item.phaseX) * item.ampX;
          var oy = Math.cos(now * item.speedY + item.phaseY) * item.ampY;
          el.style.transform = 'translate3d(' + ox + 'px,' + oy + 'px,0)';
        }
      }

      window.requestAnimationFrame(frame);
    }

    window.requestAnimationFrame(frame);
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: min(78vh, 720px);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(56, 132, 255, 0.18), transparent 55%),
      linear-gradient(180deg, #0c1422 0%, #0a0a0a 100%);
    border-bottom: 1px solid var(--border);
  }

  .pill-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .pill {
    position: absolute;
    pointer-events: auto;
    max-width: min(42vw, 260px);
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(110, 168, 255, 0.55);
    border-radius: 999px;
    background: rgba(12, 20, 34, 0.72);
    color: #9ec1ff;
    font-size: clamp(0.58rem, 1.4vw, 0.72rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(4px);
    will-change: transform, top, left, opacity;
    transform: translate3d(0, 0, 0);
  }

  .pill.is-animating {
    pointer-events: none;
  }

  .pill:hover {
    color: #e8f1ff;
    border-color: #8bb6ff;
    background: rgba(30, 52, 88, 0.9);
    text-decoration: none;
    z-index: 3;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    text-align: center;
    pointer-events: none;
  }

  .typewriter {
    margin: 0;
    max-width: min(94vw, 40rem);
    font-size: clamp(1.35rem, 4.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
    color: #e8f1ff;
  }

  .typewriter-text {
    white-space: pre-wrap;
    color: #e8f1ff;
  }

  .caret {
    display: inline-block;
    margin-left: 0.05em;
    color: #6eb0ff;
    animation: blink 1s steps(1) infinite;
  }

  .intro-wrap {
    padding: 3.5rem 1.25rem 1rem;
    background:
      radial-gradient(circle at 20% 20%, rgba(56, 132, 255, 0.06), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(56, 132, 255, 0.05), transparent 35%);
  }

  .intro-card {
    max-width: 560px;
    margin: 0 auto;
    padding: 2rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: linear-gradient(180deg, #121216 0%, #0e0e11 100%);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    border-left: 3px solid #3d8b6e;
    border-right: 3px solid #3b82f6;
  }

  .intro-card h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    letter-spacing: -0.03em;
  }

  .intro-card p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .intro-card p:last-of-type {
    margin-bottom: 1.5rem;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border: 1px solid rgba(110, 168, 255, 0.7);
    border-radius: 999px;
    color: #cfe0ff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .btn:hover {
    background: rgba(59, 130, 246, 0.15);
    text-decoration: none;
  }

  .text-link {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @keyframes blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: 620px;
    }

    .pill {
      max-width: 46vw;
      font-size: 0.55rem;
      padding: 0.28rem 0.55rem;
    }
  }
</style>
