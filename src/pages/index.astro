---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Kruse"
  description="Professional background in technical sales, cybersecurity, and AI — plus writing about learning to build."
>
  <Header />
  <main class="page">
    <section class="intro">
      <p class="eyebrow">Brandon M. Kruse</p>
      <h1>Technical sales. Cybersecurity &amp; AI. Learning in public.</h1>
      <p class="lede">
        Consultative seller comfortable taking technical products and services to market —
        and a beginner builder documenting the craft of shipping software.
      </p>
    </section>

    <section class="cards" aria-label="Site sections">
      <a class="card" href="/professional">
        <span class="card-label">Professional</span>
        <h2>Experience &amp; competencies</h2>
        <p>
          Account executive background across cybersecurity, cloud, and commerce platforms —
          mid-market and enterprise cycles, channel, and cross-functional close.
        </p>
        <span class="card-cta">View professional →</span>
      </a>

      <a class="card" href="/writing">
        <span class="card-label">Writing</span>
        <h2>Notes on learning &amp; building</h2>
        <p>
          Essays and field notes on AI, cybersecurity, and longevity health.
        </p>
        <span class="card-cta">Read writing →</span>
      </a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.25rem 1rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .lede {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 38rem;
  }

  .cards {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.35rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: transparent;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    background: var(--hover);
    border-color: #3a3a40;
    text-decoration: none;
  }

  .card-label {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    flex: 1;
  }

  .card-cta {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
</style>
