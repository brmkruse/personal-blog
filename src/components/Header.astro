---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'XKruse' },
  { href: '/professional', label: 'XP' },
  { href: '/writing', label: 'Interests' },
] as const;

const socials = [
  {
    label: 'X',
    href: 'https://x.com/XKruse',
    icon: 'x',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/krusebrandon/',
    icon: 'linkedin',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/brmkruse',
    icon: 'github',
  },
] as const;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="header-inner">
    <nav class="primary-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <p class="wordmark">Brandon Kruse</p>
    <nav class="socials" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            class="social-link"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
          >
            {s.icon === 'x' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
                <path
                  fill="currentColor"
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
                />
              </svg>
            )}
            {s.icon === 'linkedin' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
                <path
                  fill="currentColor"
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                />
              </svg>
            )}
            {s.icon === 'github' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
                <path
                  fill="currentColor"
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                />
              </svg>
            )}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: 1100px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  .primary-nav {
    justify-self: start;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.85rem;
  }

  .nav-link {
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: normal;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--muted);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--muted);
  }

  .wordmark {
    margin: 0;
    justify-self: center;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .socials {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .social-link:hover {
    color: var(--text);
    background: var(--hover);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .primary-nav {
      gap: 0.1rem 0.55rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }

    .wordmark {
      font-size: 0.95rem;
    }

    .social-link {
      width: 1.85rem;
      height: 1.85rem;
    }
  }
</style>
